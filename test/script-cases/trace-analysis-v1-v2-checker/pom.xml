<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>script-cases</artifactId>
        <groupId>org.apache.skywalking</groupId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <!--
      Runs the Java native trace analysis (trace-analysis-listener-v1) and the shipped TAL native rules on the same
      segments, and compares what each sends, names and logs, event by event. Test-only, never packaged.
    -->
    <artifactId>trace-analysis-v1-v2-checker</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>org.apache.skywalking</groupId>
            <artifactId>trace-analysis-listener-v1</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jacoco</groupId>
            <artifactId>org.jacoco.core</artifactId>
            <version>${jacoco.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.skywalking</groupId>
            <artifactId>server-testing</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <properties>
        <jacoco.version>0.8.14</jacoco.version>
    </properties>

    <build>
        <plugins>
            <!-- Attaches the agent that the branch gate, CheckerListenerCoverageTest, reads in process. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <propertyName>jacocoArgLine</propertyName>
                            <includes>
                                <include>org/apache/skywalking/oap/server/analyzer/provider/trace/parser/**</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- The agent prepare-agent sets at run time, read late, beside the build's own argLine. -->
                    <argLine>@{jacocoArgLine} ${argLine}</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.openjdk.jmh</groupId>
                            <artifactId>jmh-generator-annprocess</artifactId>
                            <version>${jmh.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
            <!-- The rule files and configuration the OAP ships, read as the OAP reads them. -->
            <testResource>
                <directory>../../../oap-server/server-starter/src/main/resources</directory>
                <includes>
                    <include>tal/*.yaml</include>
                    <include>gen-ai-config.yml</include>
                    <include>trace-sampling-policy-settings.yml</include>
                    <include>endpoint-name-grouping.yml</include>
                    <include>openapi-definitions/**</include>
                    <include>gateways.yml</include>
                    <include>server-clusters.yml</include>
                </includes>
            </testResource>
        </testResources>
    </build>
</project>
